{
  "name": "simple-db-suzdalenko",
  "displayName": "Simple DB - SQL Client for SQLite, MySQL, PostgreSQL, SQL Server & Oracle",
  "description": "SQL client and database editor for SQLite, MySQL, PostgreSQL, SQL Server (MSSQL) and Oracle. Browse database objects, run queries, manage DDL and export results.",
  "version": "0.1.6",
  "publisher": "suzdalenko-dev",
  "license": "MIT",
  "icon": "resources/simple-db-marketplace.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/suzdalenko-dev/simple-db-suzdalenko.git"
  },
  "homepage": "https://github.com/suzdalenko-dev/simple-db-suzdalenko#readme",
  "bugs": {
    "url": "https://github.com/suzdalenko-dev/simple-db-suzdalenko/issues"
  },
  "engines": {
    "vscode": "^1.95.0"
  },
  "extensionKind": [
    "workspace"
  ],
  "categories": [
    "Other",
    "Data Science"
  ],
  "keywords": [
    "sql",
    "database",
    "sql client",
    "database client",
    "sql editor",
    "database editor",
    "query editor",
    "database explorer",
    "sqlite",
    "sqlite client",
    "mysql",
    "mysql client",
    "postgresql",
    "postgres",
    "postgresql client",
    "oracle",
    "oracle database",
    "oracle client",
    "plsql",
    "pl/sql",
    "sql server",
    "mssql",
    "t-sql",
    "ddl",
    "schema explorer",
    "suzdalenko", 
    "suzdalenko-dev"
  ],
  "activationEvents": [
    "onView:simpleDb.connections",
    "onView:simpleDb.results",
    "onLanguage:sql"
  ],
  "main": "./src/extension.js",
  "contributes": {
